[Unit]
Description=GoesBerry – goesproc (GOES HRIT product processor)
Documentation=https://github.com/pietern/goestools
ConditionPathExists=/usr/local/bin/goesproc
After=goesrecv.service goesberry-install-tools.service
Requires=goesrecv.service

[Service]
EnvironmentFile=/etc/goesberry/runtime.env
ExecStart=/usr/local/bin/goesproc -c /etc/goesberry/goesproc.conf \
    --subscribe tcp://127.0.0.1:5005
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goesproc

[Install]
WantedBy=multi-user.target
